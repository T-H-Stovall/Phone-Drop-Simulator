  state.pins.sort(function (a, b) { return a.n - b.n || a.t - b.t; });
  renderPins();
  toast('Pinned: ' + lab.name);
  $('srLive').textContent = 'Pinned ' + lab.name + ' from drop ' + sc.n + '. PE from height ' + fmt(st.pe, 2) + ' joules, KE ' + fmt(st.ke, 2) + ' joules.';
}
function renderPins() {
  var pins = state.pins, top = 0, many = false, html = '';
  pins.forEach(function (p) { top = Math.max(top, p.E0); if (p.n !== pins[0].n) many = true; });
  pins.forEach(function (p) {
    var cols = '';
    PIN_COLS.forEach(function (c) {
      cols += '<div class="col"><span class="well"><i class="' + c[0] + '" style="height:' + (Math.max(0, Math.min(1, p[c[0]] / top)) * 100).toFixed(1) + '%"></i></span>' +
        '<b>' + fmt(p[c[0]], 2) + '<span class="sr-only"> joules</span></b><small>' + c[1] + '<br>' + c[2] + '</small></div>';
    });
    html += '<article class="snap"><div class="snap-head"><h4>' + p.name + '</h4><button type="button" class="x" data-key="' + p.key + '" aria-label="Remove pinned moment: ' +
      p.name + ', drop ' + p.n + '">&times;</button></div>' +
      '<p class="snap-meta">Drop ' + p.n + (p.when ? ' \u00b7 ' + p.when : '') + '<br>' + fmt(p.y, 2) + ' m high \u00b7 ' + fmt(p.v, 2) + ' m/s</p>' +
      '<div class="sc">' + cols + '</div><p class="snap-tot">Total ' + fmt(p.E0, 2) + ' J</p></article>';
