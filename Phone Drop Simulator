  if (on) updateScrubUI(LAB.stateAt(sc, sc.t));
}
function updateScrubUI(st) {
  var sc = state.scrub, lab = momentLabel(sc, st), ms = sc.moments, chips = $('scMoms').children, prev = null, next = null, i, on, when;
  when = lab.name + (lab.when ? ' \u00b7 ' + lab.when : '');
  $('inScrub').value = Math.round(sc.t / sc.total * 1000);
  $('inScrub').setAttribute('aria-valuetext', lab.name + (lab.when ? ', ' + lab.when : '') + '. PE from height ' + fmt(st.pe, 2) + ' joules, KE ' + fmt(st.ke, 2) +
    ' joules, PE from squish ' + fmt(st.sq, 2) + ' joules, heat and sound ' + fmt(st.ht, 2) + ' joules.');
  $('scWhen').textContent = when;
  for (i = 0; i < ms.length; i++) {
