/* ---------- sound (off until you turn it on) ---------- */
var actx = null;
function sfx(kind, res) {
  if (!$('optSound').checked) return;
  try {
    actx = actx || new (window.AudioContext || window.webkitAudioContext)();
    if (actx.state === 'suspended') actx.resume();
    var t0 = actx.currentTime, i;
    if (kind === 'thud') {
      var o = actx.createOscillator(), g = actx.createGain(), amp = Math.min(0.6, 0.12 + res.KE * 0.05);
      o.type = 'sine'; o.frequency.setValueAtTime(140, t0); o.frequency.exponentialRampToValueAtTime(45, t0 + 0.16);
      g.gain.setValueAtTime(amp, t0); g.gain.exponentialRampToValueAtTime(0.001, t0 + 0.22);
      o.connect(g); g.connect(actx.destination); o.start(t0); o.stop(t0 + 0.25);
    } else {
      var len = Math.floor(actx.sampleRate * 0.25), buf = actx.createBuffer(1, len, actx.sampleRate), d = buf.getChannelData(0);
      for (i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 3);
      var src = actx.createBufferSource(), hp = actx.createBiquadFilter(), g2 = actx.createGain();
      src.buffer = buf; hp.type = 'highpass'; hp.frequency.value = 1800; g2.gain.value = 0.45;
      src.connect(hp); hp.connect(g2); g2.connect(actx.destination); src.start(t0 + 0.01);
      for (i = 0; i < 5; i++) {
        var p = actx.createOscillator(), pg = actx.createGain(), st = t0 + 0.05 + i * 0.06 + Math.random() * 0.04;
        p.type = 'sine'; p.frequency.value = 2800 + Math.random() * 3000;
        pg.gain.setValueAtTime(0.05, st); pg.gain.exponentialRampToValueAtTime(0.0005, st + 0.12);
        p.connect(pg); pg.connect(actx.destination); p.start(st); p.stop(st + 0.14);
      }
    }
  } catch (e) { /* no audio available: carry on silently */ }
}

