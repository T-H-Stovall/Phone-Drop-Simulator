<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;padding:env(safe-area-inset-top,0px) 0 env(safe-area-inset-bottom,0px)}body{margin:0;font:14px system-ui,sans-serif;background:#f7f7f5}img{max-width:100%}[hidden]{display:none!important}</style></head><body><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Bricolage+Grotesque:wght@600;700;800&family=DM+Mono:wght@400;500&display=swap">
<title>Phone Drop Lab</title>
<style>
/* Layout concept: a lab workbench. The drop stage (a falling phone beside a zoomed cross-section of the landing) sits on the left with the energy meters under it and the verdict below that. The setup controls sit on the right. Missions, data, graphs and the model notes live in tabs underneath. One column on phones, with the Drop button pinned to the bottom edge. */
:root{
  /* color: teal-biased neutrals, the class-handout teal as the one accent, and four energy colors that never change meaning */
  --bg:#edf3f4; --panel:#ffffff; --panel-2:#f3f8f9; --ink:#10242b; --ink-2:#4b6169; --line:#cddadf;
  --accent:#156082; --accent-ink:#ffffff; --accent-soft:#dcedf4; --focus:#0a4fb3;
  --stage:#f7fbfc;
  --pe:#d98d00; --ke:#2a6fdb; --sq:#7c52d6; --ht:#e0602a;
  --ok:#1b7f4b; --ok-soft:#e0f3e8; --bad:#c62f3b; --bad-soft:#fbe4e5; --warn:#a86400; --warn-soft:#fff1d6;
  /* type: a very legible body face, a characterful display face for headings and verdicts, a mono face for instrument readouts */
  --font-body:"Atkinson Hyperlegible",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --font-display:"Bricolage Grotesque","Atkinson Hyperlegible",system-ui,sans-serif;
  --font-data:"DM Mono",ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0d181c; --panel:#15252b; --panel-2:#1a2e35; --ink:#e6f0f3; --ink-2:#9db4bb; --line:#2c454e;
    --accent:#59b3d8; --accent-ink:#06222e; --accent-soft:#173a49; --focus:#8bb6ff; --stage:#0f1e23;
    --pe:#f2b632; --ke:#6ea6ff; --sq:#b096f5; --ht:#ff8a55;
    --ok:#5bcc90; --ok-soft:#153b2a; --bad:#ff6f79; --bad-soft:#40191d; --warn:#f0b04a; --warn-soft:#3a2b10;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0d181c; --panel:#15252b; --panel-2:#1a2e35; --ink:#e6f0f3; --ink-2:#9db4bb; --line:#2c454e;
  --accent:#59b3d8; --accent-ink:#06222e; --accent-soft:#173a49; --focus:#8bb6ff; --stage:#0f1e23;
  --pe:#f2b632; --ke:#6ea6ff; --sq:#b096f5; --ht:#ff8a55;
  --ok:#5bcc90; --ok-soft:#153b2a; --bad:#ff6f79; --bad-soft:#40191d; --warn:#f0b04a; --warn-soft:#3a2b10;
  color-scheme:dark;
}

*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:15px;line-height:1.5;padding-inline:16px;padding-block:16px 40px}
.wrap{max-width:1200px;margin:0 auto}
h1,h2,h3,h4,p,figure{margin:0}
button,input,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.muted{color:var(--ink-2);font-size:14px}

/* header */
.top{display:flex;gap:12px 24px;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;margin-bottom:16px}
.title{min-width:0;max-width:760px}
h1{font:800 clamp(28px,4.4vw,38px)/1.02 var(--font-display);letter-spacing:-.015em;text-wrap:balance}
.sub{color:var(--ink-2);margin-top:6px;max-width:64ch}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{display:inline-flex;gap:7px;align-items:center;padding:6px 12px;border:1px solid var(--line);border-radius:999px;background:var(--panel);font-size:14px;cursor:pointer;min-height:36px}
.chip input{accent-color:var(--accent);width:16px;height:16px;margin:0}

/* layout */
.workbench{display:grid;gap:14px;grid-template-columns:minmax(0,1fr);margin-bottom:14px}
.side{display:contents}
.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px;min-width:0}
.h2{font:700 19px/1.2 var(--font-display);margin-bottom:12px}
.h3{font:700 16px/1.2 var(--font-display);margin:16px 0 6px}
@media (min-width:980px){
  .workbench{grid-template-columns:minmax(0,1fr) 380px;grid-template-areas:"stage side" "result side";align-items:start}
  .stage{grid-area:stage}
  .result{grid-area:result}
  .side{display:flex;flex-direction:column;gap:12px;grid-area:side;min-width:0}
}

/* stage */
.views{display:grid;gap:12px;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr)}
.pane{min-width:0}
.pane-title{font:700 14px/28px var(--font-body);height:28px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pane-title span{font-weight:400;color:var(--ink-2);margin-left:6px;font-size:13px}
.cv{display:block;width:100%;border:1px solid var(--line);border-radius:8px;background:var(--stage)}
.cv-stage{height:380px}
.cv-zoom{height:352px}
.live{display:flex;gap:6px 22px;flex-wrap:wrap;margin-top:10px;font-size:13px;color:var(--ink-2)}
.live b{font:500 15px var(--font-data);color:var(--ink);margin-left:4px;font-variant-numeric:tabular-nums}
.bars{display:grid;gap:2px}
.ebar{display:grid;grid-template-columns:minmax(118px,150px) minmax(0,1fr) 64px;gap:10px;align-items:center;min-height:28px}
.nm{font-size:14px;white-space:nowrap}
.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:7px}
.dot.pe,.fill.pe{background:var(--pe)} .dot.ke,.fill.ke{background:var(--ke)} .dot.sq,.fill.sq{background:var(--sq)} .dot.ht,.fill.ht{background:var(--ht)}
.track{position:relative;height:16px;background:var(--panel-2);border:1px solid var(--line);border-radius:8px;overflow:hidden}
.fill{position:absolute;inset:0;transform-origin:left center;transform:scaleX(0)}
.num{font:500 13px var(--font-data);text-align:right;font-variant-numeric:tabular-nums}
.bar-note{margin-top:8px;color:var(--ink-2);font-size:14px}
.bar-note b{font-family:var(--font-data);font-weight:500;color:var(--ink)}
.h3row{display:flex;justify-content:space-between;align-items:center;gap:6px 12px;flex-wrap:wrap;margin:16px 0 6px}
.h3row .h3{margin:0}

/* replay: step through a finished drop, then pin moments to compare their energy */
.replay{margin-top:16px;padding-top:14px;border-top:1px solid var(--line)}
.replay-head{display:flex;justify-content:space-between;align-items:baseline;gap:2px 16px;flex-wrap:wrap;margin-bottom:8px}
.replay-head .h3{margin:0}
.when{font:500 14px var(--font-data);color:var(--ink);font-variant-numeric:tabular-nums;min-height:21px}
.scrub-box{min-width:0}
input.scrub{-webkit-appearance:none;appearance:none;display:block;background:transparent;cursor:pointer}
.scrub::-webkit-slider-runnable-track{height:8px;border-radius:4px;background:var(--panel-2);box-shadow:inset 0 0 0 1px var(--line)}
.scrub::-moz-range-track{height:8px;border-radius:4px;background:var(--panel-2);box-shadow:inset 0 0 0 1px var(--line)}
.scrub::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;margin-top:-7px;border-radius:50%;background:var(--accent);border:3px solid var(--panel);box-shadow:0 0 0 1.5px var(--accent)}
.scrub::-moz-range-thumb{box-sizing:border-box;width:22px;height:22px;border-radius:50%;background:var(--accent);border:3px solid var(--panel);box-shadow:0 0 0 1.5px var(--accent)}
input.scrub:disabled,.replay .sbtn:disabled,.mom:disabled{opacity:.5;cursor:not-allowed}
.phases{position:relative;display:flex;height:22px;margin:0 11px}
.ph{flex:1 1 0%;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;padding:0 3px;font-size:11px;line-height:22px;text-align:center;color:var(--ink-2);background:var(--panel-2);border:1px solid var(--line);border-left-width:0}
.ph:first-child{border-left-width:1px;border-radius:5px 0 0 5px}
.ph:last-child{border-radius:0 5px 5px 0}
@media (max-width:700px){.ph{font-size:10px;padding:0 1px}}
.ph.k-collision{background:var(--accent-soft)}
.tick{position:absolute;top:-4px;width:2px;height:9px;margin-left:-1px;border-radius:1px;background:var(--ink-2)}
.moms{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.mom{font-size:13px;min-height:34px;padding:4px 11px}
.mom.on{border-color:var(--accent);background:var(--accent-soft);box-shadow:inset 0 0 0 1px var(--accent)}
.replay .muted{margin-top:10px}

/* compare: pinned moments, one small column chart each, all on the same joule scale */
.compare{margin-top:6px}
.snaps{display:grid;gap:10px;grid-template-columns:repeat(auto-fill,minmax(min(100%,220px),1fr));margin-top:8px}
.snaps:empty{display:none}
.snap{background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:10px 12px;min-width:0}
.snap-head{display:flex;justify-content:space-between;align-items:flex-start;gap:6px}
.snap h4{font:700 15px/1.25 var(--font-display);overflow-wrap:anywhere}
.snap .x{flex:none;width:32px;height:32px;margin:-6px -8px 0 0;border:0;border-radius:8px;background:none;font-size:22px;line-height:1;color:var(--ink-2);cursor:pointer}
.snap .x:hover{background:var(--line);color:var(--ink)}
.snap-meta{margin:2px 0 8px;font-size:12px;line-height:1.4;color:var(--ink-2)}
.sc{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
.col{display:flex;flex-direction:column;align-items:center;gap:3px;min-width:0}
.well{position:relative;display:block;width:100%;height:96px;background:var(--panel);border:1px solid var(--line);border-radius:6px;overflow:hidden}
.well i{position:absolute;left:0;right:0;bottom:0}
.well i.pe{background:var(--pe)} .well i.ke{background:var(--ke)} .well i.sq{background:var(--sq)} .well i.ht{background:var(--ht)}
.col b{font:500 12px var(--font-data);font-variant-numeric:tabular-nums}
.col small{font-size:11px;line-height:1.15;color:var(--ink-2);text-align:center}
.snap-tot{margin-top:8px;font:500 12px var(--font-data);color:var(--ink-2)}

/* controls */
.field{border:0;padding:0;margin:0 0 16px;min-width:0}
.lab{display:flex;justify-content:space-between;align-items:baseline;gap:8px;padding:0;margin-bottom:6px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--ink-2)}
legend.lab{display:block}
.val{font:500 16px var(--font-data);color:var(--ink);letter-spacing:0;text-transform:none;font-variant-numeric:tabular-nums}
.step-row{display:grid;grid-template-columns:40px minmax(0,1fr) 40px;gap:8px;align-items:center}
input[type=range]{width:100%;height:36px;margin:0;accent-color:var(--accent)}
.sbtn{width:40px;height:40px;border-radius:8px;border:1px solid var(--line);background:var(--panel-2);font-size:22px;line-height:1;cursor:pointer}
.sbtn:hover{border-color:var(--accent)}
.opts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.opts.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.opt{position:relative;display:flex;align-items:center;gap:10px;padding:8px 10px;min-height:50px;border:1.5px solid var(--line);border-radius:10px;background:var(--panel-2);cursor:pointer;min-width:0}
.opt input{position:absolute;opacity:0;width:1px;height:1px}
.opt.on{border-color:var(--accent);background:var(--accent-soft);box-shadow:inset 0 0 0 1px var(--accent)}
.opt:focus-within{outline:3px solid var(--focus);outline-offset:2px}
.opt b{display:block;font-size:14px;line-height:1.2}
.opt small{display:block;font-size:12px;color:var(--ink-2);line-height:1.2;margin-top:2px}
.opts.three .opt{flex-direction:column;align-items:flex-start;gap:0}
.sw{width:30px;height:30px;border-radius:6px;flex:none;border:1px solid rgba(0,0,0,.28)}
.sw-concrete{background:radial-gradient(circle at 25% 30%,rgba(255,255,255,.4) 1px,transparent 2px) 0 0/9px 9px,radial-gradient(circle at 70% 70%,rgba(0,0,0,.3) 1px,transparent 2px) 0 0/7px 7px,#8b9298}
.sw-tile{background:linear-gradient(90deg,rgba(0,0,0,.3) 1.5px,transparent 1.5px) 0 0/15px 15px,linear-gradient(rgba(0,0,0,.3) 1.5px,transparent 1.5px) 0 0/15px 15px,#d5dee2}
.sw-wood{background:repeating-linear-gradient(0deg,#b98450 0 6px,#8f6236 6px 7px)}
.sw-carpet{background:radial-gradient(circle,rgba(255,255,255,.4) 1px,transparent 1.5px) 0 0/5px 5px,#5f82ab}
.sw-grass{background:repeating-linear-gradient(90deg,#4b8f3d 0 2px,#63ab4f 2px 5px)}
.sw-foam{background:radial-gradient(circle,rgba(255,255,255,.6) 2px,transparent 2.5px) 0 0/8px 8px,#88bccb}
.glass-info{font-size:14px;color:var(--ink-2);margin-top:8px}
.glass-info b{font-family:var(--font-data);font-weight:500;color:var(--ink)}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:8px}
.row.between{justify-content:space-between}
.wrap-row{align-items:flex-start}

/* buttons */
.btn{font-weight:700;font-size:14px;padding:8px 14px;min-height:40px;border-radius:8px;border:1.5px solid var(--accent);background:var(--accent);color:var(--accent-ink);cursor:pointer}
.btn:hover{filter:brightness(1.07)}
.btn.ghost{background:transparent;color:var(--accent)}
.btn.small{padding:5px 11px;min-height:34px;font-size:13px}
.btn:disabled,.drop:disabled{opacity:.55;cursor:not-allowed}
.dropbar{position:sticky;bottom:0;z-index:5;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px calc(12px + env(safe-area-inset-bottom,0px));box-shadow:0 -8px 20px rgba(8,30,40,.10)}
.drop{display:block;width:100%;padding:14px 16px;min-height:54px;border:0;border-radius:10px;background:var(--accent);color:var(--accent-ink);font:800 20px var(--font-display);letter-spacing:.005em;cursor:pointer}
.drop:hover:not(:disabled){filter:brightness(1.08)}
.dropbar .row{margin-top:10px}
.tally{font:500 13px var(--font-data);color:var(--ink-2)}
.predict{position:absolute;left:0;right:0;bottom:calc(100% + 8px);z-index:7;padding:10px 12px;border-radius:10px;background:var(--warn-soft);border:1px solid var(--warn);box-shadow:0 10px 26px rgba(8,30,40,.24)}
.predict p{color:var(--ink)}
.predict .row{margin-top:8px}

/* result */
.tag{display:inline-block;margin-bottom:12px;padding:4px 10px;border-radius:6px;background:var(--warn-soft);border:1px solid var(--warn);font-size:13px}
.verdict{display:grid;grid-template-columns:auto minmax(0,1fr);gap:18px;padding:16px;border-radius:10px;background:var(--ok-soft);align-items:center}
.verdict.bad{background:var(--bad-soft)}
.vphone svg{display:block;width:84px;height:auto}
.vtitle{font:800 26px/1.05 var(--font-display);letter-spacing:-.01em;margin-bottom:6px}
.verdict.bad .vtitle{color:var(--bad)}
.verdict:not(.bad) .vtitle{color:var(--ok)}
.why{margin-top:6px;color:var(--ink-2);font-size:14px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(128px,1fr));gap:8px;margin-top:12px}
.stat{background:var(--panel-2);border:1px solid var(--line);border-radius:8px;padding:8px 10px;min-width:0}
.stat span{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-2)}
.stat b{display:block;font:500 20px/1.3 var(--font-data);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.meterbox{margin-top:18px}
.meter{position:relative;height:16px;background:var(--panel-2);border:1px solid var(--line);border-radius:8px}
.meter .fill{position:absolute;inset:0;transform-origin:left center;background:var(--ok);border-radius:7px}
.meter.bad .fill{background:var(--bad)}
.meter .mark{position:absolute;top:-6px;bottom:-6px;width:3px;margin-left:-1.5px;background:var(--ink);border-radius:2px}
.meter-lab{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:8px;font:500 13px var(--font-data);color:var(--ink-2)}
.fx{margin-top:16px}
.fx svg{display:block;width:100%;height:auto;max-height:340px}
.fx figcaption{font-size:14px;color:var(--ink-2);margin-top:6px;max-width:72ch}
.predres{margin-top:12px;font-weight:700}

/* tabs */
.tabs-card{padding:0 16px 16px}
.tabs{display:flex;gap:2px;border-bottom:1px solid var(--line);overflow-x:auto}
.tab{padding:14px 16px 12px;border:0;border-bottom:3px solid transparent;background:none;color:var(--ink-2);font-weight:700;font-size:15px;cursor:pointer;white-space:nowrap}
.tab[aria-selected=true]{color:var(--ink);border-bottom-color:var(--accent)}
.badge{display:inline-block;min-width:22px;padding:0 6px;margin-left:4px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font:500 12px/20px var(--font-data);text-align:center}
.panel{padding-top:16px}
.lead{font:700 16px var(--font-display);margin-bottom:12px}
.missions{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))}
.mission{display:grid;grid-template-columns:34px minmax(0,1fr);gap:12px;padding:12px 14px;border:1px solid var(--line);border-radius:10px;background:var(--panel)}
.mission.done{background:var(--ok-soft);border-color:var(--ok)}
.mno{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font:800 16px var(--font-display);background:var(--accent-soft);color:var(--accent)}
.mission.done .mno{background:var(--ok);color:var(--panel)}
.mission h4{font:700 16px/1.25 var(--font-display);margin-bottom:4px}
.mission p{margin-bottom:6px}
.mission .note{font-size:14px;color:var(--ink-2)}
.mission .note b{color:var(--ink)}
.mission details{font-size:14px;color:var(--ink-2)}
.mission summary{cursor:pointer;color:var(--accent);font-weight:700}
.tablewrap{overflow-x:auto;margin-top:12px;border:1px solid var(--line);border-radius:8px}
table{border-collapse:collapse;width:100%;font-size:13px}
th{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;text-align:left;color:var(--ink-2);background:var(--panel-2);border-bottom:2px solid var(--line);padding:8px 10px;white-space:nowrap}
td{padding:7px 10px;border-bottom:1px solid var(--line);font-family:var(--font-data);white-space:nowrap;font-variant-numeric:tabular-nums}
tr:last-child td{border-bottom:0}
.r{text-align:right}
.pill{display:inline-block;padding:1px 9px;border-radius:999px;font:500 12px/20px var(--font-data)}
.pill.ok{background:var(--ok-soft);color:var(--ok)}
.pill.bad{background:var(--bad-soft);color:var(--bad)}
.copybox{width:100%;min-height:130px;margin-top:10px;padding:8px;font:12px/1.4 var(--font-data);background:var(--panel-2);border:1px solid var(--line);border-radius:8px}
.graphs{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));margin-top:14px}
.gfig figcaption{font:700 15px var(--font-display);margin-bottom:6px}
.gfig svg{display:block;width:100%;height:auto}
.legend{margin-top:8px;font-size:14px;color:var(--ink-2)}
.lg{display:inline-block;width:12px;height:12px;margin:0 5px 0 14px;vertical-align:-1px}
.lg.ok{border-radius:50%;background:var(--ok)}
.lg.bad{background:linear-gradient(45deg,transparent 42%,var(--bad) 42% 58%,transparent 58%),linear-gradient(-45deg,transparent 42%,var(--bad) 42% 58%,transparent 58%)}
.prose h3{font:700 17px var(--font-display);margin:18px 0 4px}
.prose h3:first-child{margin-top:0}
.prose p,.prose li{max-width:72ch}
.prose ul{margin:4px 0 10px;padding-left:20px}
.mathbox{margin-top:12px;padding:12px 14px;font:13px/1.7 var(--font-data);background:var(--panel-2);border:1px solid var(--line);border-radius:8px;overflow-x:auto;white-space:pre}

.toast{position:fixed;left:50%;bottom:calc(132px + env(safe-area-inset-bottom,0px));transform:translate(-50%,10px);max-width:min(92vw,440px);padding:10px 16px;border-radius:10px;background:var(--ink);color:var(--panel);font-weight:700;font-size:14px;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;z-index:20}
.toast.show{opacity:1;transform:translate(-50%,0)}

/* svg graphs */
.g-bg{fill:var(--panel-2)}
.g-grid{stroke:var(--line);stroke-width:1;fill:none}
.g-axis{stroke:var(--ink-2);stroke-width:1.5;fill:none}
.g-tick{fill:var(--ink-2);font:11px var(--font-data)}
.g-lab{fill:var(--ink-2);font:12px var(--font-body)}
.g-note{fill:var(--ink);font:500 12px var(--font-data)}
