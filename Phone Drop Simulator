  if (!sc) {
    if (shownScrub !== 'preview') {
      shownScrub = 'preview';
      renderMoms(LAB.scrubber(LAB.compute({ h: 1, phoneG: 180, surface: 'concrete', caseId: 'none', breakN: 1e9 })).moments);
      $('scPhases').innerHTML = ''; $('inScrub').value = 0; $('scWhen').textContent = '';
    }
    $('scNote').textContent = 'Drop the phone, then use this slider to look at any moment of the drop and the collision.';
  } else {
    $('scNote').textContent = 'A real collision lasts only about ' + fmt(sc.res.tImpact * 1000, 1) + ' ms. It is stretched out here so you can see it.';
  }
  els = document.querySelectorAll('#replay input, #replay button, #btnPin');
