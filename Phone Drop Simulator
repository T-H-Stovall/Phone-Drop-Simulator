var PIN_COLS = [['pe', 'PE', 'height'], ['ke', 'KE', 'motion'], ['sq', 'PE', 'squish'], ['ht', 'Heat', '+ sound']];
function pinMoment() {
  var sc = state.scrub; if (!sc || state.running) return;
