<script>
/* ===== Physics model (no DOM in here, so it can be tested on its own) ===== */
var LAB = (function () {
  'use strict';
  var G = 9.8;           // m/s^2
  var PHONE_GIVE = 1.5;  // mm the phone body itself squishes for every 1000 N

  // give = mm of squish for every 1000 N of force. ret = share of the impact energy that comes back as a bounce.
  var SURFACES = [
    { id: 'concrete', name: 'Concrete',   feel: 'very hard', give: 0.5, ret: 0.20 },
    { id: 'tile',     name: 'Tile',       feel: 'hard',      give: 1.5, ret: 0.16 },
    { id: 'wood',     name: 'Wood floor', feel: 'firm',      give: 3.5, ret: 0.09 },
    { id: 'carpet',   name: 'Carpet',     feel: 'soft',      give: 12,  ret: 0.02 },
    { id: 'grass',    name: 'Grass',      feel: 'softer',    give: 20,  ret: 0.01 },
    { id: 'foam',     name: 'Foam mat',   feel: 'very soft', give: 30,  ret: 0.01 }
  ];
  var CASES = [
    { id: 'none',   name: 'No case',           sub: 'bare phone', add: 0,  give: 0,  ret: 1.0 },
    { id: 'thin',   name: 'Thin plastic',      sub: '+15 g',      add: 15, give: 2,  ret: 0.8 },
    { id: 'rubber', name: 'Rubber case',       sub: '+50 g',      add: 50, give: 8,  ret: 0.5 },
    { id: 'bumper', name: 'Air-pocket bumper', sub: '+70 g',      add: 70, give: 14, ret: 0.3 }
  ];
  var GLASSES = [
    { id: 'thin',    name: 'Thin glass',    breakN: 1000 },
    { id: 'thick',   name: 'Thick glass',   breakN: 1600 },
    { id: 'mystery', name: 'Mystery glass', breakN: null }
  ];

  function pick(list, id) {
    for (var i = 0; i < list.length; i++) if (list[i].id === id) return list[i];
    return list[0];
  }

  // p = { h (m), phoneG (g), surface (id), caseId (id), breakN (N) }
  function compute(p) {
    var S = pick(SURFACES, p.surface), C = pick(CASES, p.caseId);
    var totalG = p.phoneG + C.add, m = totalG / 1000, h = p.h;
    var v = Math.sqrt(2 * G * h);              // speed when it lands
    var tFall = Math.sqrt(2 * h / G);          // time to fall
    var E0 = m * G * h;                        // PE at the top = KE at the bottom
    var comp = PHONE_GIVE + S.give + C.give;   // phone, case and surface squish in a stack (mm per 1000 N)
    var k = 1e6 / comp;                        // stiffness of the whole stack, N per m
    var x = Math.sqrt(2 * E0 / k);             // biggest squish, m  (energy stored = 1/2 k x^2 = KE)
    var F = k * x;                             // peak force, N
    var cracked = F > p.breakN;
    var ret = S.ret * C.ret * (cracked ? 0.5 : 1);
    var bounces = [], hb = h;
    for (var i = 0; i < 3; i++) { hb *= ret; if (hb < 0.01) break; bounces.push(hb); }
    return {
      h: h, phoneG: p.phoneG, totalG: totalG, m: m, weight: m * G,
      v: v, tFall: tFall, E0: E0, KE: E0,
      comp: comp, k: k, xmm: x * 1000, F: F,
      tImpact: Math.PI * Math.sqrt(m / k),       // how long the squish and spring-back really last, s (a half-cycle of the spring, twice)
      parts: { phone: F * PHONE_GIVE / 1000, cushion: F * C.give / 1000, surface: F * S.give / 1000 },
      brk: p.breakN, cracked: cracked, ratio: F / p.breakN,
      ret: ret, bounces: bounces,
      surface: S.id, surfaceName: S.name, caseId: C.id, caseName: C.name
    };
  }

  // Animation timeline. Every segment has a duration (seconds on screen) and at(u) for u in 0..1 that returns
  // the physical state: y (m above the surface), s (squish, 0..1 of the biggest), F (N), and the four energies (J).
  // tp is the real time (s) on this phase's own clock: since release for the fall, since first touching the floor
  // for the squish and spring-back (a few thousandths of a second), and since leaving the floor for a bounce.
  function timeline(r, slow) {
    var m = r.m, E0 = r.E0, T = r.tFall, segs = [], HALF = Math.PI / 2, half = r.tImpact / 2;
    var crackU = r.cracked ? Math.asin(Math.min(1, r.brk / r.F)) / HALF : null;
    var dc = slow < 1 ? 0.6 : 0.3;

    segs.push({ kind: 'fall', dur: Math.max(0.35, T / slow), at: function (u) {
      var t = u * T, y = Math.max(0, r.h - 0.5 * G * t * t), v = G * t;
      return { phase: 'fall', t: t, tp: t, y: y, s: 0, F: 0, pe: m * G * y, ke: 0.5 * m * v * v, sq: 0, ht: 0, crackT: 0 };
    } });

    segs.push({ kind: 'compress', dur: dc, at: function (u) {
      var th = u * HALF, s = Math.sin(th), c = Math.cos(th);
      var ck = (crackU !== null && u >= crackU) ? Math.min(1, (u - crackU) / 0.3) : 0;
      return { phase: 'compress', t: T, tp: u * half, y: 0, s: s, F: r.F * s, pe: 0, ke: E0 * c * c, sq: E0 * s * s, ht: 0, crackT: ck };
    } });

    segs.push({ kind: 'release', dur: dc, at: function (u) {
      var w = Math.sin(u * HALF); w = w * w;                 // share of the stored energy that has been let go
      return { phase: 'release', t: T, tp: half + u * half, y: 0, s: Math.cos(u * HALF), F: r.F * Math.cos(u * HALF),
               pe: 0, ke: r.ret * E0 * w, sq: E0 * (1 - w), ht: (1 - r.ret) * E0 * w, crackT: r.cracked ? 1 : 0 };
    } });

    var lastMech = r.ret * E0;
    r.bounces.forEach(function (hb) {
      var mech = m * G * hb, Tb = 2 * Math.sqrt(2 * hb / G);
      lastMech = mech;
      segs.push({ kind: 'bounce', dur: Math.max(0.25, Tb / slow), at: function (u) {
        var y = 4 * hb * u * (1 - u), pe = m * G * y;
        return { phase: 'bounce', t: T, tp: u * Tb, y: y, s: 0, F: 0, pe: pe, ke: Math.max(0, mech - pe), sq: 0, ht: E0 - mech, crackT: r.cracked ? 1 : 0 };
      } });
    });

    var lm = lastMech;
    segs.push({ kind: 'settle', dur: 0.5, at: function (u) {
      var ke = lm * (1 - u);
      return { phase: 'settle', t: T, tp: 0, y: 0, s: 0, F: 0, pe: 0, ke: ke, sq: 0, ht: E0 - ke, crackT: r.cracked ? 1 : 0 };
    } });
    return segs;
  }

  /* ---- Step through a finished drop. The scrubber is the slow-motion timeline, so the slider always covers the same
     stretch of screen time whatever the display options are. moments are the times worth jumping to (t = seconds into it). ---- */
  var SCRUB_SLOW = 0.35;
  function scrubber(r) {
    var segs = timeline(r, SCRUB_SLOW), starts = [], total = 0, moments = [];
    segs.forEach(function (s) { starts.push(total); total += s.dur; });
    function at(i, u) { return starts[i] + segs[i].dur * u; }        // segs: 0 fall, 1 squish, 2 spring back, then bounces, then settle
    moments.push({ id: 'top',  name: 'Release',            t: 0 });
    moments.push({ id: 'half', name: 'Halfway down',       t: at(0, Math.SQRT1_2) });   // height = h(1 - u^2), so u = 1/sqrt(2) is half the height
    moments.push({ id: 'hit',  name: 'Just before impact', t: at(0, 1) });
    moments.push({ id: 'mid',  name: 'Half-squished',      t: at(1, 0.5) });
    moments.push({ id: 'max',  name: 'Most squished',      t: at(1, 1) });
    moments.push({ id: 'off',  name: r.bounces.length ? 'Leaving the floor' : 'Squish released', t: at(2, 1) });
    if (r.bounces.length) moments.push({ id: 'apex', name: 'Top of the bounce', t: at(3, 0.5) });
    moments.push({ id: 'rest', name: 'At rest',            t: total });
