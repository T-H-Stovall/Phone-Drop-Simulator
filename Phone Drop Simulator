}
function renderMoms(list) {
  var html = '';
  list.forEach(function (m, i) { html += '<button type="button" class="chip mom" data-i="' + i + '" aria-pressed="false">' + m.name + '</button>'; });
  $('scMoms').innerHTML = html;
}
function buildScrub() {
  var res = state.res; if (!res) return;
  var sc = LAB.scrubber(res), bands = [], html = '';
  sc.n = state.trials.length; sc.t = sc.total;          // a finished drop starts out showing where it ended
  sc.segs.forEach(function (g) {
    var last = bands[bands.length - 1], b = BAND[g.kind];
    if (last && last.kind === b[0]) last.dur += g.dur; else bands.push({ kind: b[0], name: b[1], dur: g.dur });
  });
  bands.forEach(function (b) { html += '<span class="ph k-' + b.kind + '" style="flex-grow:' + b.dur.toFixed(3) + '">' + b.name + '</span>'; });
  sc.moments.forEach(function (m) { html += '<i class="tick" style="left:' + (m.t / sc.total * 100).toFixed(2) + '%"></i>'; });
  $('scPhases').innerHTML = html; renderMoms(sc.moments);
