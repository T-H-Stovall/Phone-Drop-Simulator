  return null;
}
function whenText(st) {
  if (st.kind === 'fall') return fmt(st.tp, 2) + ' s after release';
  if (st.kind === 'compress' || st.kind === 'release') return fmt(st.tp * 1000, 1) + ' ms after impact';
  if (st.kind === 'bounce') return fmt(st.tp, 2) + ' s in the air';
  return '';
}
function momentLabel(sc, st) {
