}
function tickText(v) { return String(Math.round(v * 100) / 100); }
function scatter(id, pts, o) {
  var W = 440, H = 290, L = 60, R = 16, T = 14, B = 48, pw = W - L - R, ph = H - T - B, s = '', v;
  var mx = 0, my = 0; pts.forEach(function (p) { mx = Math.max(mx, p.x); my = Math.max(my, p.y); });
  var xa = axisFor(Math.max(o.xMin, mx * 1.08)), ya = axisFor(Math.max(o.yMin, my * 1.08));
  function X(a) { return L + a / xa.top * pw; }
  function Y(a) { return T + ph - a / ya.top * ph; }
  s += '<rect class="g-bg" x="' + L + '" y="' + T + '" width="' + pw + '" height="' + ph + '"/>';
  for (v = 0; v <= xa.top + 1e-9; v += xa.step) s += '<line class="g-grid" x1="' + X(v) + '" y1="' + T + '" x2="' + X(v) + '" y2="' + (T + ph) + '"/><text class="g-tick" x="' + X(v) + '" y="' + (T + ph + 16) + '" text-anchor="middle">' + o.xf(v) + '</text>';
  for (v = 0; v <= ya.top + 1e-9; v += ya.step) s += '<line class="g-grid" x1="' + L + '" y1="' + Y(v) + '" x2="' + (L + pw) + '" y2="' + Y(v) + '"/><text class="g-tick" x="' + (L - 6) + '" y="' + (Y(v) + 4) + '" text-anchor="end">' + o.yf(v) + '</text>';
  s += '<line class="g-axis" x1="' + L + '" y1="' + (T + ph) + '" x2="' + (L + pw) + '" y2="' + (T + ph) + '"/><line class="g-axis" x1="' + L + '" y1="' + T + '" x2="' + L + '" y2="' + (T + ph) + '"/>';
  s += '<text class="g-lab" x="' + (L + pw / 2) + '" y="' + (H - 8) + '" text-anchor="middle">' + o.xLab + '</text>';
  s += '<text class="g-lab" transform="translate(13 ' + (T + ph / 2) + ') rotate(-90)" text-anchor="middle">' + o.yLab + '</text>';
  if (!pts.length) s += '<text class="g-lab" x="' + (L + pw / 2) + '" y="' + (T + ph / 2) + '" text-anchor="middle">Your drops will appear here.</text>';
  if (o.connect) {
    var groups = {};
